{
  "name": "debug-better",
  "version": "1.0.0",
  "description": "Advanced TypeScript debugging utility with filtering capabilities for Node.js and browser",
  "keywords": [
    "debug",
    "log",
    "debugger",
    "typescript",
    "filtering",
    "logger",
    "utility"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": "./dist/browser.js",
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "node dist/examples/test.js",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "ms": "^2.1.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/ms": "^0.7.34",
    "typescript": "^5.3.3",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "prettier": "^3.1.1"
  },
  "homepage": "https://github.com/punnayansaha07/debug-utility#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/punnayansaha07/debug-utility.git"
  },
  "author": "Punnayan Saha <punnayan79@gmail.com>",
  "license": "MIT"
}
